<?xml version="1.0" encoding="utf-8"?>
<!--
  A dark, slightly translucent pill with a light stroke, so the overlay stays legible over both
  Uber's light and dark interfaces without needing to know which one is showing
  (spec section 47).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/overlay_scrim" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="#40FFFFFF" />
</shape>
